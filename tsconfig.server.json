{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@schema/*": ["./schema/*"]
    },
    "baseUrl": "."
  },
  "include": ["server/**/*", "schema/**/*"]
}
